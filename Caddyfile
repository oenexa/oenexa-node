# Caddyfile — OENEXA Layer-1 JSON-RPC, Status, Health & Rosetta Gateway
{$OENEXA_DOMAIN:node.oenexa.io} {
    handle /healthz {
        reverse_proxy oenexa-node:8545
    }

    handle /api/* {
        reverse_proxy oenexa-node:8545
    }

    handle /network/* {
        reverse_proxy oenexa-node:8545
    }

    handle /account/* {
        reverse_proxy oenexa-node:8545
    }

    handle /block* {
        reverse_proxy oenexa-node:8545
    }

    handle /mempool* {
        reverse_proxy oenexa-node:8545
    }

    handle /construction/* {
        reverse_proxy oenexa-node:8545
    }

    handle_path /rpc* {
        reverse_proxy oenexa-node:8545
    }

    handle {
        reverse_proxy oenexa-node:8545
    }
}
