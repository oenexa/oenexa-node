# 10. Canonical 301 Vanity Redirects (preserving SPA origin & SEO)
exchange.oenexa.com {
    redir https://app.oenexa.com/exchange{uri} permanent
}

trade.oenexa.com {
    redir https://app.oenexa.com/trade{uri} permanent
}

wallet.oenexa.com {
    redir https://app.oenexa.com/wallet{uri} permanent
}

coin.oenexa.com {
    redir https://oenexa.com/coins{uri} permanent
}

identity.oenexa.com {
    redir https://id.oenexa.com{uri} permanent
}

# 11. Plaintext bare IP Redirect
http://62.210.92.60 {
    redir https://oenexa.com{uri} permanent
}
