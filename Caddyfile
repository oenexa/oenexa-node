# Caddyfile — OENEXA Layer-1 JSON-RPC, Status, Health & Rosetta Gateway
{$OENEXA_DOMAIN:rpc.oenexa.com}, node.oenexa.com, chain.oenexa.com {
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }

    handle /metrics* {
        respond 403
    }

    handle /actuator* {
        respond 403
    }

    handle /healthz {
        reverse_proxy oenexa-node:8545
    }

    handle /api/* {
        reverse_proxy oenexa-node:8545
    }

    handle /network/* {
        reverse_proxy oenexa-node:8545
    }

    handle /account/* {
        reverse_proxy oenexa-node:8545
    }

    handle /block* {
        reverse_proxy oenexa-node:8545
    }

    handle /mempool* {
        reverse_proxy oenexa-node:8545
    }

    handle /construction/* {
        reverse_proxy oenexa-node:8545
    }

    handle_path /rpc* {
        reverse_proxy oenexa-node:8545
    }

    handle {
        reverse_proxy oenexa-node:8545
    }
}
