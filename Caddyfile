# Caddyfile — OENEXA Unified Ecosystem Edge Router (Phase 4 Canonical Host Routing)

# 1. Main Website & Public Portal
oenexa.com, www.oenexa.com {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    handle /actuator/* {
        respond 403
    }

    handle /metrics* {
        respond 403
    }

    # Dual-mode subpath routing (fallback for non-subdomain traffic)
    handle_path /rpc* {
        reverse_proxy oenexa-node:8545
    }

    handle /api/* {
        reverse_proxy oenexa-ai-core:8080
    }

    handle /ai* {
        reverse_proxy oenexa-ai-web:80
    }

    handle /explorer* {
        reverse_proxy oenexa-explorer:80
    }

    handle {
        reverse_proxy oenexa-ui:80
    }
}

# 2. Unified Customer Application Portal
app.oenexa.com {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    handle /actuator/* {
        respond 403
    }

    handle /metrics* {
        respond 403
    }

    handle /api/* {
        reverse_proxy oenexa-ai-core:8080
    }

    handle {
        reverse_proxy oenexa-ui:80
    }
}

# 3. Central Identity & SSO Authority
id.oenexa.com {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    handle /actuator/* {
        respond 403
    }

    handle /metrics* {
        respond 403
    }

    handle /.well-known/* {
        reverse_proxy oenexa-ai-core:8080
    }

    handle /api/v1/auth/* {
        reverse_proxy oenexa-ai-core:8080
    }

    handle {
        reverse_proxy oenexa-ui:80
    }
}

